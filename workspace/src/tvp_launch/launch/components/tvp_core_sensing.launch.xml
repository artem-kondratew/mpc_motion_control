<launch>
  <arg name="use_rosbag" default="false"/>
  <arg name="vehicle_id" default="alpha" description="префикс робота: namespace + TF-фреймы (2+ роботов в одной сети)"/>

  <group>
    <!-- namespacing: /<vehicle_id>/sensing/livox/...; выходные фреймы lidar_70/imu_70 префиксованы -->
    <push-ros-namespace namespace="$(var vehicle_id)"/>
    <push-ros-namespace namespace="sensing"/>

    <!-- TurtleBot2 sensing: Livox MID360 driver -->
    <!-- robot_configs (внутренний gitlab) для turtlebot нет, поэтому драйвер подключается напрямую -->
    <include file="$(find-pkg-share livox_drivers)/launch/all_lidars.launch.py">
      <arg name="use_rosbag" value="$(var use_rosbag)"/>
      <arg name="frame_prefix" value="$(var vehicle_id)/"/>
    </include>
  </group>
</launch>
