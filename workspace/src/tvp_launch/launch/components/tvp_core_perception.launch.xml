<launch>
  <group>
    <push-ros-namespace namespace="perception"/>

    <include file="$(find-pkg-share tvp_launch)/launch/components/perception/crop_box_filters.launch.xml">
    </include>

    <node pkg="autoware_pointcloud_preprocessor" exec="pickup_based_voxel_grid_downsample_filter_node" name="perception_voxel_node">
      <param from="$(find-pkg-share tvp_launch)/config/perception/voxel_filter.param.yaml"/>
      <remap from="input" to="lidar/cropped/pointcloud"/>
      <remap from="output" to="pointcloud/preprocessed"/>
      <param name="input_frame" value="base_link"/>
      <param name="output_frame" value="base_link"/>
    </node>
    
    <include file="$(find-pkg-share linefit)/launch/linefit_node.launch.py">
      <arg name="input_topic" value="pointcloud/preprocessed"/>
      <arg name="ground_output_topic" value="ground_segmentation/pointcloud"/>
      <arg name="obstacle_output_topic" value="obstacle_segmentation/pointcloud"/>
    </include>

    <!-- <include file="$(find-pkg-share tvp_launch)/launch/components/perception/scan_ground_filter.launch.xml">
    </include> -->

    <include file="$(find-pkg-share astral_detection_launch)/launch/detection.launch.xml">
    </include>

    <include file="$(find-pkg-share safety_contour)/launch/safety_contour.launch.py">
    </include>

  </group>
</launch>
