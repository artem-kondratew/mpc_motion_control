<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="vehicle_id" default="bravo" description="префикс робота: namespace + TF-фреймы (2+ роботов в одной сети)"/>

  <group>
    <!-- namespacing: /<vehicle_id>/{cmd_vel,odom,drive_controller/*}; фреймы odom-сообщения префиксованы -->
    <push-ros-namespace namespace="$(var vehicle_id)"/>

    <!-- STM diff-drive (bravo): drive_controller -->
    <!-- cmd_vel (от control) -> колёса (drive_controller/cmd_vel_*) + odom (для CC v_meas / lateral w_meas). -->
    <!-- ВНИМАНИЕ: чтобы колёса реально поехали, нужен micro-ROS agent (связь с прошивкой STM). -->
    <!-- udp_bridge пока НЕ включён — топики drive_controller должны совпасть с прошивкой напрямую. -->
    <include file="$(find-pkg-share drive_controller)/launch/drive_controller.launch.py">
      <arg name="frame_prefix" value="$(var vehicle_id)/"/>
    </include>
  </group>

</launch>
