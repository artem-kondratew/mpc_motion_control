<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="vehicle_id" default="alpha" description="префикс робота: namespace + TF-фреймы (2+ роботов в одной сети)"/>

  <group>
    <!-- namespacing: /<vehicle_id>/{odom,cmd_vel,commands/velocity,...}; TF odom/base префиксованы -->
    <push-ros-namespace namespace="$(var vehicle_id)"/>

    <!-- TurtleBot2 (Kobuki) base driver -->
    <!-- поднимает kobuki_ros_node + cmd_vel_wrapper (cmd_vel -> commands/velocity) -->
    <include file="$(find-pkg-share kobuki_node)/launch/kobuki.launch.py">
      <arg name="frame_prefix" value="$(var vehicle_id)/"/>
    </include>
  </group>

</launch>
