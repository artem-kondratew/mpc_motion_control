<?xml version="1.0" encoding="utf-8"?>

<launch>
    <arg name="use_rosbag" default="false"/>

    <group unless="$(var use_rosbag)">
        <node pkg="peakpoints_ud_x1_5_driver" exec="peakpoints_ud_x1_5_driver" output="screen">
            <param name="ip"   value="10.111.0.71"/>
            <param name="port" value="3005"/>

            <remap from="out_bestpos"  to="peakpoints/bestpos"/>
            <remap from="out_heading2" to="peakpoints/heading2"/>
            <remap from="out_inspva"   to="peakpoints/inspva"/>
            <remap from="out_inspvax"  to="peakpoints/inspvax"/>
        </node>
    </group>
</launch>