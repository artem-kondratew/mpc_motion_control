VEHICLE_ID=bravo

IMAGE="tvp_image:$VEHICLE_ID"

#
# Параметры запуска сервисов стека
#
CMD="/bin/bash -ic"

# serial-устройство STM для micro-ROS agent (профиль microros). by-id стабильнее /dev/ttyUSB*
MICROROS_DEV="/dev/serial/by-id/usb-Prolific_Technology_Inc._USB-Serial_Controller-if00-port0"

# Режим управления: true = CC + удержание в полосе (lateral); false = ТОЛЬКО CC (едет прямо)
LATERAL=true
# Форма полосы (при LATERAL=true): line | circle | lanelet
TRAJECTORY=lanelet
# Файл waypoints для TRAJECTORY=lanelet (лежит в swarm_controller/config/)
TRAJECTORY_FILE=my_trajectory5.yaml

#
# --- Колонна / адаптивный круиз-контроль (ACC) -------------------------------
# Продольный контур: cc = свой v_ref (лидер alpha) | acc = зазор за лидером (ведомый bravo).
LONGITUDINAL=acc
# Кто лидер колонны (префикс его топиков). На ОБОИХ роботах = alpha.
LEADER_ID=alpha

# UDP-мост (profile v2v). На лидере (alpha): V2V_ROLE=leader, PEER_IP = IP ВЕДОМОГО (bravo).
# На ведомом (bravo): V2V_ROLE=follower, PEER_IP не используется.
V2V_ROLE=follower
PEER_IP=192.168.3.23

# Статическая стыковка карт lio_sam: поза старта ЛИДЕРА в системе координат ВЕДОМОГО.
# Только на ведомом (bravo): PEER_TF=true. На лидере (alpha): PEER_TF=false, оффсеты 0.
# Если bravo стартует на dм позади alpha по +x своей карты -> PEER_TF_X=d, Y=0, YAW=0.
# d = целевой зазор на старте = d0 (acc_mpc.param.yaml). На ходу ACC раздвинет до d0+th*v.
PEER_TF=true
PEER_TF_X=0.5
PEER_TF_Y=0.0
PEER_TF_YAW=0.0

LOGGING_MODE=auto  # debug | auto | manual  (всегда auto)
EXPERIMENT_GROUP_NAME=""
LOGGING_DIRECTORY="${EXPERIMENT_GROUP_NAME:-default}"

