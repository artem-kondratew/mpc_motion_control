VEHICLE_ID=alpha

IMAGE="tvp_image:$VEHICLE_ID"

#
# Параметры запуска сервисов стека
#
CMD="/bin/bash -ic"

# Режим управления: true = CC + удержание в полосе (lateral); false = ТОЛЬКО CC (едет прямо)
LATERAL=true
# Форма полосы (при LATERAL=true): line | circle | lanelet
TRAJECTORY=lanelet
# Файл waypoints для TRAJECTORY=lanelet (лежит в swarm_controller/config/)
TRAJECTORY_FILE=my_trajectory5.yaml

#
# --- Колонна / адаптивный круиз-контроль (ACC) -------------------------------
# Продольный контур: cc = свой v_ref (лидер alpha) | acc = зазор за лидером (ведомый bravo).
# alpha — ЛИДЕР колонны: едет на своём v_ref (cc).
LONGITUDINAL=cc
# Кто лидер колонны (префикс его топиков). На ОБОИХ роботах = alpha.
LEADER_ID=alpha

# UDP-мост (profile v2v). На лидере (alpha): V2V_ROLE=leader, PEER_IP = IP ВЕДОМОГО (bravo).
V2V_ROLE=leader
PEER_IP=192.168.3.22

# Статическая стыковка карт lio_sam (нужна только ведомому). На лидере: PEER_TF=false, оффсеты 0.
PEER_TF=false
PEER_TF_X=0.0
PEER_TF_Y=0.0
PEER_TF_YAW=0.0

LOGGING_MODE=auto  # debug | auto | manual  (всегда auto)
EXPERIMENT_GROUP_NAME=""
LOGGING_DIRECTORY="${EXPERIMENT_GROUP_NAME:-default}"
